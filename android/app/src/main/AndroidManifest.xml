<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Remote debug log shipping (core/debug/RemoteLog.kt) posts batches to a
         developer server. Both are normal-tier permissions — no runtime prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- MediaStore saving on legacy devices only (API <= 28); scoped storage
         (29+) needs no storage permission. Requested at runtime together with
         CAMERA by CameraScreen. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Public inbox import (/sdcard/PhotographerCamera): reading arbitrary
         files on shared storage on Android 11+ needs All-Files-Access. The
         app is sideloaded, so this is the pragmatic route (like pro camera
         apps); granted via the system settings page, requested once. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- In-app OTA update (core/update/UpdateChecker.kt): the app installs its
         own downloaded APK through the system installer. Normal-tier, no
         runtime prompt; the user grants "install unknown apps" once via the
         system page on first install attempt (API 26+). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 0.6.0 "保存地址位置"开关（默认关）：EXIF GPS 写入用。运行时权限由
         系统设置页授予（开关开启时引导），未授权时静默跳过 GPS。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- READ_PHONE_STATE is never declared by this app. It is silently IMPLIED
         into the merged manifest by the manifest merger because
         org.tensorflow.lite.gpu.api ships an AAR manifest without a
         targetSdkVersion (< 4), which triggers the legacy auto-grant rule.
         We use no telephony APIs — strip it explicitly. -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />

    <!-- OpenGL ES 3.0 is REQUIRED: the renderer uses #version 300 es shaders. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- heifwriter (photon 引擎拉入) 要求 minSdk 28，本项目 minSdk 26；
         HEIF 编解码仅在新设备运行，旧设备运行时不会触及，override 安全。 -->
    <uses-sdk tools:overrideLibrary="androidx.heifwriter" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PhotographerCamera"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotographerCamera"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the OTA-downloaded APK (app-private cache) with the system
             installer; paths in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Look/recipe cross-process store used by LutManager (upstream mgc providers). -->
        <provider
            android:name="com.photographercamera.photon.mgc.PhotonLookProvider"
            android:authorities="${applicationId}.mgc.look"
            android:exported="true" />

        <provider
            android:name="com.photographercamera.photon.mgc.PhotonRawProvider"
            android:authorities="${applicationId}.mgc.raw"
            android:exported="true" />
    </application>
</manifest>
