# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# datasets (raw photographer images are large, keep out of git)
dataset/accepted/*
dataset/rejected/*
dataset/review/*
!dataset/**/.gitkeep
dataset/dataset_metadata.json
dataset/cleaning_report.json

# profiles (generated/real profiles managed separately; keep schema only)
profiles/*.json
!profiles/schema/*.json

# build artifacts
build/
dist/
build_new/
dist_new/
*.apk
*.aab

# machine-specific config (local SDK paths)
local.properties

# logs
*.log

# IDE / editor
.idea/
*.iml
.vscode/

# Android / Gradle
.gradle/
captures/
.cxx/

# debug screenshots & temp captures (project root)
/_*.png
/_*.jpg
/_*.xml
/_raw_rot/
filter_test.png
proof_out/
ui_test*.png
ui_presets*.png

# desktop viewer session outputs (regenerated by smoke tests)
studio_session/

# vendor clones & temp
vendor/
_s0*.json
*.apk

# server upload token (secret - never commit)
server/upload.token.local
build2/

# R2 release temp artifacts (regenerated per release)
/_r2urls.txt
/android/_r2_version.json

# one-off refactor scripts (0.9.7 core->photon package migration)
/_core_photon_closure.py
/_core_photon_keep.txt

# upstream-source diffing session artifacts (0.9.16 成片体积诊断)
/_engine_diff.json
/_up_diff_hunks.txt
/_up_tree.json
tools/_up_*.txt
tools/_diff_gallery.txt
tools/_devlog.json
tools/_cmp_filter.py
tools/_cmp_full.py
tools/_show_diff.py
tools/_scan_log_sizes.py
tools/_fetch_upfile.py
